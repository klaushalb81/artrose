# Copy to .env.local for local development. Never commit real values.
# On Netlify, set each of these under Site configuration → Environment variables.

# Public URL of the site (no trailing slash). Used for Stripe redirects and viewing links.
SITE_URL=http://localhost:3000

# Postgres connection string.
# Supabase: Project → Connect → "Transaction pooler" URI (port 6543).
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# Stripe (Developers → API keys). Use test keys locally, live keys on Netlify.
STRIPE_SECRET_KEY=sk_test_...
# Stripe (Developers → Webhooks → your endpoint → Signing secret),
# or the value printed by `stripe listen` when testing locally.
STRIPE_WEBHOOK_SECRET=whsec_...

# Cloudflare Stream API — used by the admin dashboard (video upload/status) and
# by scripts/cloudflare-stream.mjs. Token needs the "Stream: Edit" permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare Stream — used by the site to play videos.
# Customer code: Stream → any video → Embed; the URL looks like customer-<CODE>.cloudflarestream.com
CLOUDFLARE_STREAM_CUSTOMER_CODE=
# Signing key: run `node scripts/cloudflare-stream.mjs create-key` and paste both values.
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_KEY_PEM=

# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Encrypts the stored copy of viewing tokens. Changing it later breaks re-display of existing links.
VIEWING_TOKEN_ENCRYPTION_KEY=

# Password for the admin dashboard at /admin (at least 12 characters).
ADMIN_PASSWORD=

# Optional: e-mail customers their video link, sent from this Gmail account.
# Needs 2-Step Verification on the Google account, then create an app password at
# https://myaccount.google.com/apppasswords and paste the 16 characters here.
GMAIL_USER=artrosefys@gmail.com
GMAIL_APP_PASSWORD=
